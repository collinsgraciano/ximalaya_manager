# ═══════════════════════════════════════════════
# ximalaya_manager — Backblaze B2 备份配置
# ═══════════════════════════════════════════════
# 复制为 .env 并填入实际值

# ─── VPS SSH 连接 ───
VPS_HOST=117.55.234.219
VPS_PORT=22
VPS_USER=root
VPS_PASS=your_vps_password

# ─── VPS Docker/PostgreSQL ───
VPS_CONTAINER=xm_postgres
VPS_DB_USER=xm_app
VPS_DB_NAME=ximalaya
VPS_PROJECT_DIR=/opt/ximalaya_manager

# ─── Backblaze B2 (S3 兼容 API) ───
# 在 B2 控制台 → Buckets 页面获取 Endpoint
# 在 B2 控制台 → App Keys 页面创建 key，获取 keyID 和 applicationKey
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_ACCESS_KEY_ID=your_key_id
B2_SECRET_ACCESS_KEY=your_application_key
B2_BUCKET=xm-backups

# ─── 备份设置 ───
# 保留备份数量（旧的自动删除）
# 注意: B2 免费额度 10GB，每份备份约 205MB，建议 7 份 ≈ 1.4GB
BACKUP_KEEP=7
# 定时备份间隔（小时），仅 daemon 模式使用
BACKUP_INTERVAL_HOURS=24
