# ═══════════════════════════════════════════════
# 喜马拉雅有声书管理系统 — 环境变量配置
# ═══════════════════════════════════════════════
# 复制为 .env 并修改密码等敏感信息

# PostgreSQL 密码
POSTGRES_PASSWORD=changeme_strong_password

# Web 应用密钥（用于 Cookie 签名）
SECRET_KEY=dev_secret_key_change_in_production

# 应用访问密码
APP_PASSWORD=inriynisse

# 基础 URL（VPS 部署时改为实际域名或 IP）
BASE_URL=http://localhost:59388

# Colab Worker 认证 Token（Colab 连接 VPS API 时使用）
WORKER_AUTH_TOKEN=changeme_worker_token
